PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kcttw?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
VITE_API_URL=/api

# Korapay Payment Gateway Configuration
KORAPAY_SECRET_KEY=pk_test_... or sk_live_...
KORAPAY_PUBLIC_KEY=pk_test_... or pk_live_...
KORAPAY_ENCRYPTION_KEY=...
KORAPAY_BASE_URL=https://api.korapay.com

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="KCTTW — Kamba Collection" <no-reply@kcttw.com>
ADMIN_EMAIL=admin@kcttw.com
